+        if (i) i.className = 'fa-solid ' + (t === 'dark' ? 'fa-sun' : 'fa-moon');
+      };
+      window.toggleTheme = function () {
+        var t = document.documentElement.classList.contains('dark') ? 'light' : 'dark';
+        try { localStorage.setItem('theme', t); } catch (e) {}
+        if (document.startViewTransition && !(window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches)) {
+          document.documentElement.dataset.dir = 'fade';
+          document.startViewTransition(function () { applyTheme(t); });
+        } else applyTheme(t);
+      };
+      document.documentElement.classList.toggle('dark', saved() === 'dark');
+      document.addEventListener('DOMContentLoaded', function () { applyTheme(saved() === 'dark' ? 'dark' : 'light'); });
+    })();
+  </script>
   
